server {
    listen 443 ssl http2;
    server_name agent.talos.love;
    # Existing public certificate paths; do not reuse the private upstream CA.
    ssl_certificate /opt/talos-server/tls/public/fullchain.pem;
    ssl_certificate_key /opt/talos-server/tls/public/privkey.pem;

    location ^~ /talos.agent.v1. {
        grpc_pass grpcs://127.0.0.1:9443;
        grpc_ssl_verify on;
        grpc_ssl_server_name on;
        grpc_ssl_name talos-agent.internal;
        grpc_ssl_trusted_certificate /opt/talos-server/tls/ca.crt;
        grpc_read_timeout 3600s;
        grpc_send_timeout 3600s;
    }

    location ~ ^/v1/sessions/[^/]+/events$ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        add_header Cache-Control "no-cache";
        add_header X-Accel-Buffering "no";
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        gzip on;
    }
}
