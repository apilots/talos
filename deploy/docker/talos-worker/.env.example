# Published Worker image; no Server or WebUI process is started.
TALOS_WORKER_VERSION=v0.1.12
TALOS_WORKER_IMAGE=ghcr.io/apilots/talos-worker

# Required: use the UUID issued by the authenticated Computer creation API.
TALOS_WORKER_NODE_ID=

# Isolated writable home; prepare its config and credential before starting.
TALOS_WORKER_HOME=./home

# Optional deployment-owned provider key. Omit when it belongs in home/.env.
# TALOS_LLM_DEEPSEEK_API_KEY=
