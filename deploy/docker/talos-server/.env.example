# Deployment image: use a published version tag, not latest.
TALOS_SERVER_VERSION=v0.1.10
TALOS_SERVER_IMAGE=ghcr.io/apilots/talos-server

# Talos Server production profile only; the general Compose example does not use these inputs.
TALOS_SERVER_DATA_VOLUME=talos-server_talos-data
TALOS_SERVER_TLS_DIR=/opt/talos-server/tls

# Optional deployment-owned provider secrets. Uncomment only non-empty values.
# Leave omitted when the product UI owns that key in $TALOS_HOME/.env.
# Keep the deployed .env private (mode 0600).
# TALOS_LLM_ANTHROPIC_API_KEY=
# TALOS_LLM_BAILIAN_API_KEY=
# TALOS_LLM_OPENAI_API_KEY=
# TALOS_LLM_DEEPSEEK_API_KEY=
# TALOS_LLM_OPENROUTER_API_KEY=

# Talos writes product secrets to its separate persistent $TALOS_HOME/.env.
# Do not bind mount this deployment file over that runtime file.
