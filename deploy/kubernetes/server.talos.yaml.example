workspaces:
  default_workspace_id: default
  definitions:
    - workspace_id: default
      root_prefix: workspace-talos
agent:
  name: talos
gateway:
  host: 0.0.0.0
  port: 8080
  auth: true
llm:
  provider: deepseek
  model: deepseek-v4-flash
agent_node:
  control_plane:
    bind_address: 0.0.0.0:9443
    tls_certificate_file: /run/talos-tls/tls.crt
    tls_private_key_file: /run/talos-tls/tls.key
    trusted_node_ca_file: /run/talos-tls/ca.crt
cloud:
  agent_base_url: https://talos-server.talos.svc:9443
  agent_trusted_ca_file: /run/talos-tls/ca.crt
talos:
  worker:
    runtime:
      kind: Kubernetes
      # Shared baseline for either backend without its own worker block.
      image: ghcr.io/apilots/talos-worker@sha256:<worker-image-digest>
      control_plane_endpoint: https://talos-server.talos.svc:9443
      trusted_ca_file: /run/talos-tls/ca.crt
      docker_engine:
        socket_path: /var/run/docker.sock
        # worker: {image: <pinned-image>, control_plane_endpoint: <https-origin>, trusted_ca_file: null}
        resources: {cpu_cores: 4, memory_bytes: 8589934592, shm_bytes: 1073741824}
      kubernetes:
        # worker: {image: <pinned-image>, control_plane_endpoint: <https-origin>, trusted_ca_file: null}
        resources: {cpu_cores: 4, memory_bytes: 8589934592, shm_bytes: 1073741824}
        home_bytes: 100000000000
        kubeconfig_source: InCluster
        kubeconfig_path: null
        kubeconfig_context: null
        namespace: talos
        storage_class: talos-xfs-quota
        seccomp_profile: talos/chromium-seccomp.json
        home_quota_enforced: false
  server:
    runtime:
      idle_timeout_seconds: 900
      request_wait_seconds: 45
      start_timeout_seconds: 120
      wake_cooldown_seconds: 60
