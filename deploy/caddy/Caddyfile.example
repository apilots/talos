# Talos Server virtual host only; merge with the existing proxy configuration.
# Do not replace other Cloud/Sync virtual hosts. See ../TALOS_SERVER.md.
agent.talos.love {
	@grpc path /talos.agent.v1.*
	handle @grpc {
		reverse_proxy https://127.0.0.1:9443 {
			flush_interval -1
			transport http {
				versions 2
				tls_server_name talos-agent.internal
				tls_trust_pool file /opt/talos-server/tls/ca.crt
			}
		}
	}

	@sse path /v1/sessions/*/events

	handle @sse {
		header {
			Cache-Control no-cache
			X-Accel-Buffering no
		}
		reverse_proxy 127.0.0.1:8080 {
			flush_interval -1
		}
	}

	handle {
		encode zstd gzip
		reverse_proxy 127.0.0.1:8080
	}
}
