{
  "name": "talos-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "pnpm build && electron .",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src vite.config.ts --ext .ts",
    "test": "vitest run --passWithNoTests",
    "check": "pnpm lint && pnpm test && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@talos/sdk-app-server": "workspace:*",
    "@talos/sdk-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^41.3.0",
    "eslint": "^9.25.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.2"
  }
}
