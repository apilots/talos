{
  "name": "talos-app",
  "version": "0.1.19-SNAPSHOT",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "pnpm@9.14.4",
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@napi-rs/canvas": "1.0.13",
    "@tanstack/eslint-plugin-query": "5.108.4",
    "@vitest/eslint-plugin": "1.6.27",
    "dependency-cruiser": "18.9.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-testing-library": "7.16.3",
    "knip": "6.48.0",
    "typescript-eslint": "^8.31.1"
  },
  "scripts": {
    "dev": "pnpm --filter talos-web dev",
    "desktop:dev": "pnpm --filter talos-desktop dev",
    "desktop:build": "pnpm --filter talos-desktop build",
    "desktop:check": "pnpm --filter talos-desktop check",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "check": "pnpm --filter talos-web check",
    "check:repo": "node ./scripts/check-repo.mjs && node --test ./scripts/error-presentation-rule.test.mjs ./scripts/static-analysis-rules.test.mjs ./scripts/architecture-rules.test.mjs && python3 ../scripts/check_error_contract.py && pnpm check:architecture && pnpm check:unused",
    "ci:frontend-app": "pnpm typecheck && pnpm lint && pnpm check:repo && pnpm test && pnpm build:checked",
    "check:architecture": "depcruise --config .dependency-cruiser.cjs web/src",
    "check:unused": "knip",
    "build:checked": "pnpm --filter talos-web build:bundle && pnpm --filter talos-desktop build:checked"
  },
  "pnpm": {
    "overrides": {
      "react-pdf>pdfjs-dist": "6.4.299"
    },
    "patchedDependencies": {
      "@novnc/novnc@1.5.0": "patches/@novnc__novnc@1.5.0.patch"
    }
  }
}
