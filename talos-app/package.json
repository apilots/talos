{
  "name": "talos-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.14.4",
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "typescript-eslint": "^8.31.1"
  },
  "scripts": {
    "dev": "pnpm --filter talos-web dev",
    "desktop:dev": "pnpm --filter talos-desktop dev",
    "desktop:build": "pnpm --filter talos-desktop build",
    "desktop:check": "pnpm --filter talos-desktop check",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "check": "pnpm --filter talos-web check",
    "check:repo": "node ./scripts/check-repo.mjs",
    "ci:frontend-app": "pnpm check && pnpm check:repo"
  }
}
